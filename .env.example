# Ví MỚI, chỉ dùng cho bot. Đừng dùng ví chính.
# Dán private key vào đây, trên máy bạn. Đừng gửi file này hay khoá cho bất kỳ ai.
PRIVATE_KEY=

# Ít nhất 2 RPC, cách nhau bằng dấu phẩy. Bot đối chiếu giá trước khi làm gì.
RPC_URLS=https://rpc.elysium.kinetiq.xyz,https://rpc-live.boxa.club,https://rpc.boxa.club,https://rpc.eleos.fun,https://rpc.stockium.fun,https://rpc.elysiumswap.finance

# Khoảng vị thế mới = giá hiện tại ± bấy nhiêu phần trăm, làm tròn theo tickSpacing 200.
RANGE_PCT=20

# Cân bằng lại khi giá cách mép khoảng này ≤ bấy nhiêu %, hoặc khi giá đã ra ngoài khoảng.
TRIGGER_PCT=5

# Bao lâu thì hỏi giá một lần (giây). Tối thiểu 5.
POLL_SECONDS=30

# Trượt giá tối đa, tính bằng basis point. 50 = 0.5%.
MAX_SLIPPAGE_BPS=50

# Sau mỗi lần cân bằng lại, nghỉ ít nhất bấy nhiêu phút.
MIN_REBALANCE_INTERVAL_MINUTES=60

# Gas ước lượng cao hơn số này thì hủy, không gửi.
MAX_GAS=1500000

# true = chỉ in ra màn hình, không gửi giao dịch. Đổi thành false khi bạn đã đọc log và hiểu rủi ro.
DRY_RUN=true

# Luôn để lại bấy nhiêu HYPE trả gas. Bot không đụng vào phần này.
GAS_RESERVE_HYPE=0.08
